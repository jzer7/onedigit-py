{
    "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
    "name": "Python 3",
    // https://mcr.microsoft.com/en-us/artifact/mar/devcontainers/python/about
    "image": "mcr.microsoft.com/devcontainers/python:3-3.14-trixie",
    "features": {
        "ghcr.io/devcontainers-extra/features/apt-get-packages:1.0.8": {
            // "source": "https://github.com/devcontainers-extra/features/tree/main/src/apt-get-packages",
            // "release": "https://github.com/devcontainers-extra/features/pkgs/container/features%2Fapt-get-packages",
            // "1.0.8": "sha256:776fa11c30c50fa91d5e1bf050444b0f130827457109c349db92e8e126b750ec",
            "packages": "vim"
        },
        "ghcr.io/devcontainers-extra/features/go-task:1.0.6": {
            // "source": "https://github.com/devcontainers-extra/features/tree/main/src/go-task",
            // "release": "https://github.com/devcontainers-extra/features/pkgs/container/features%2Fgo-task"
            // "1.0.6": "sha256:4d1db153919976cadd3209ca05d655a761a01707767716994dad677b4538dc1b"
            // "task": "https://github.com/go-task/task/releases"
            "version": "3.53.0"
        },
        "ghcr.io/devcontainers-extra/features/uv:1.0.2": {
            // "source": "https://github.com/devcontainers-extra/features/tree/main/src/uv",
            // "release": "https://github.com/devcontainers-extra/features/pkgs/container/features%2Fuv"
            // "1.0.2": "sha256:1ac5b9f17a9e9e745933d0ac2ecf758e06ed3da4423cd22c94cce4d482fd2dd8"
            // "uv": "https://github.com/astral-sh/uv/releases"
            "version": "0.11.31"
        }
    },
    "forwardPorts": [],
    "runArgs": ["--add-host=ollama.local:host-gateway"],
    "mounts": ["source=python,target=/python,type=volume"],
    "postCreateCommand": ".devcontainer/post-create.sh",
    "customizations": {
        "vscode": {
            "extensions": [
                "charliermarsh.ruff",
                "DavidAnson.vscode-markdownlint",
                "EditorConfig.EditorConfig",
                "ms-python.python",
                "redhat.vscode-yaml",
                "streetsidesoftware.code-spell-checker",
                "tamasfe.even-better-toml",
                "task.vscode-task",
                "timonwong.shellcheck"
            ],
            "settings": {
            }
        }
    },
    "remoteUser": "vscode"
}
